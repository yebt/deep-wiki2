# Environment template for deep-wiki.
#
# Copy this file to `.env` at the repository root before running anything:
#
#     cp env.example .env
#
# `.env` is gitignored and holds your real values; this file is committed and
# must never contain a secret. Every variable declared in
# packages/contracts/src/env.ts has to appear here — `bun run check` fails if
# the two drift apart.

# Runtime mode. One of: development | production | test
NODE_ENV=development

# Port the API listens on.
# Keep this at 1024 or above: rootless podman cannot bind lower ports.
PORT=3000

# Postgres connection string. Must be a valid URL.
# Matches the credentials used by the compose stack.
DATABASE_URL=postgres://deepwiki:deepwiki@localhost:5432/deepwiki
