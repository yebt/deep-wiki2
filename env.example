# Environment template for deep-wiki.
#
# Copy this file to `.env` at the repository root before running anything:
#
#     cp env.example .env
#
# `.env` is gitignored and holds your real values; this file is committed and
# must never contain a secret. Every variable declared in
# packages/contracts/src/env.ts has to appear here — `bun run check` fails if
# the two drift apart.

# Runtime mode. One of: development | production | test
NODE_ENV=development

# Port the API listens on.
# Keep this at 1024 or above: rootless podman cannot bind lower ports.
PORT=3000

# Postgres connection string. Must be a valid URL.
# Matches the credentials used by the compose stack.
DATABASE_URL=postgres://deepwiki:deepwiki@localhost:5432/deepwiki

# Public base URL, used to build links embedded in email (invitations,
# password reset).
# The browser-facing origin of apps/web — NOT the API. Two things depend on it:
# it is the single origin the API allows through CORS with credentials, and it
# is the host of the /reset-password and /invite/accept links mailed to users.
# In development that is the Nuxt dev server, which is not PORT above.
APP_URL=http://localhost:4173

# Where the browser should reach apps/api. Must point at PORT above.
# Nuxt maps NUXT_PUBLIC_* onto runtimeConfig.public automatically.
NUXT_PUBLIC_API_BASE_URL=http://localhost:3000

# Session lifetime. Idle timeout slides on activity; absolute timeout is a
# hard cap regardless of activity.
SESSION_IDLE_TIMEOUT_MINUTES=30
SESSION_ABSOLUTE_TIMEOUT_DAYS=30

# Token time-to-live.
PASSWORD_RESET_TTL_MINUTES=30
INVITATION_TTL_DAYS=7

# SMTP configuration for the MailSender adapter. SMTP_HOST and MAIL_FROM
# are required — the application always needs to be able to send mail for
# invitations and password reset. The values below match the compose
# stack's Mailpit service (no authentication needed), so a fresh clone
# boots with zero configuration.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=noreply@deep-wiki.local

# BlobStore adapter selection. One of: filesystem | s3
# filesystem is the default — a self-hoster on a single VPS will not run
# MinIO. Only BLOB_STORE_FS_ROOT is required for the filesystem driver.
BLOB_STORE_DRIVER=filesystem
BLOB_STORE_FS_ROOT=./.data/blobs

# The variables below are only required when BLOB_STORE_DRIVER=s3. They
# stay empty here — no secret ships in this template. The values that
# would work against the local compose MinIO service are:
#   BLOB_STORE_S3_ENDPOINT=http://localhost:9000
#   BLOB_STORE_S3_REGION=us-east-1
#   BLOB_STORE_S3_BUCKET=deep-wiki
#   BLOB_STORE_S3_ACCESS_KEY_ID=<MINIO_ROOT_USER>
#   BLOB_STORE_S3_SECRET_ACCESS_KEY=<MINIO_ROOT_PASSWORD>
BLOB_STORE_S3_ENDPOINT=
BLOB_STORE_S3_REGION=us-east-1
BLOB_STORE_S3_BUCKET=
BLOB_STORE_S3_ACCESS_KEY_ID=
BLOB_STORE_S3_SECRET_ACCESS_KEY=

# The variables below are read by compose.yaml, not by the zod schema in
# packages/contracts/src/env.ts — they configure the local compose stack
# itself (postgres and minio credentials) and are not part of the app's own
# configuration surface. They still belong in .env because podman/docker
# compose loads that same file automatically.

# Credentials for the postgres service in compose.yaml. Must match the
# user/password embedded in DATABASE_URL above.
# Published host ports for the compose stack. The defaults are the conventional
# ones; change them here if your machine already runs another project on them.
# `podman compose up` fails on a port collision before any service starts.
POSTGRES_HOST_PORT=5432
MAILPIT_SMTP_HOST_PORT=1025
MAILPIT_UI_HOST_PORT=8025
MINIO_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001
KROKI_HOST_PORT=8000

POSTGRES_USER=deepwiki
POSTGRES_PASSWORD=deepwiki
POSTGRES_DB=deepwiki

# Credentials for the minio service in compose.yaml (S3-compatible object
# storage console at http://localhost:9001).
MINIO_ROOT_USER=deepwiki
MINIO_ROOT_PASSWORD=deepwiki-minio
