/.atl

# dependencies
node_modules/

# build output
dist/
.output/
.nuxt/
.astro/
*.tsbuildinfo

# env & secrets
.env
.env.*

# test & tooling
coverage/
playwright-report/
test-results/
.turbo/

# generated by e2e/global-setup.ts at test-run time — real tokens for a
# throwaway per-run database, never checked in
e2e/.auth-fixtures.json

# nuxt-generated bookkeeping (e.g. one-time module setup tracking written
# by @nuxt/test-utils) — regenerated automatically, not hand-authored
.nuxtrc

# editors & os
.DS_Store
*.swp
# Local AI runtime state
.atl/

# scripts/checks/bundle-isolation-build.ts's fixtures deliberately
# reproduce a `.output/server/chunks/virtual/precomputed.mjs` path shape
# to exercise the check without a real `nuxt build` — un-ignore them
# despite the `.output/` rule above (same self-describing-fixture problem
# `query-boundaries.ts` and `single-parser.ts` already have for forbidden
# literals, here applied to a path instead of a string).
!scripts/checks/__fixtures__/bundle-isolation-build/**
!scripts/checks/__fixtures__/bundle-isolation-build/**/.output/
!scripts/checks/__fixtures__/bundle-isolation-build/**/.output/**

# CodeGraph index — per checkout, never shared or committed
.codegraph/
